#!/bin/sh
# `hermes` for herdr-hermes: loads the model API key for the Hermes process tree only, from the read-only file mount
# /run/secrets/nvidia_api_key. The container environment, the herdr server and the pane shells never carry it.
if [ -r /run/secrets/nvidia_api_key ]; then
  NVIDIA_API_KEY="$(tr -d '\r\n' </run/secrets/nvidia_api_key)"
  export NVIDIA_API_KEY
fi
exec /opt/hermes/.venv/bin/hermes "$@"
