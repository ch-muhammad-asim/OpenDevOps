#!/bin/sh
# Shell for every work pane: an SSH session into hermes-workbench as `worker`. So a command typed into a work pane
# (herdr pane run) runs in the workbench, next to Hermes's other commands, where no real herdr binary exists.
# The pane key is accepted there with `restrict,pty` only.
exec ssh -tt -q -i /data/ssh/pane_ed25519 \
  -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes \
  -o UserKnownHostsFile=/ctlkeys/workbench_known_hosts -o ServerAliveInterval=30 \
  -p 2222 worker@hermes-workbench 'cd /work/workspace && exec bash -l'
