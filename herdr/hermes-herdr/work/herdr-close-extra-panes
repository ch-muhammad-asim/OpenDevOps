#!/usr/bin/python3 -I
"""Operator/test helper (docker exec only; herdr-broker does not expose it): close every work pane except the first,
so tests and benchmarks start from one pane."""
import json
import subprocess

HERDR = "/usr/local/bin/herdr"
panes = json.loads(subprocess.run([HERDR, "pane", "list"], capture_output=True, text=True, check=True).stdout)
panes = panes["result"]["panes"]
for pane in panes[1:]:
    subprocess.run([HERDR, "pane", "close", pane["pane_id"]], capture_output=True, check=False)
print(f"closed {max(len(panes) - 1, 0)} pane(s)")
