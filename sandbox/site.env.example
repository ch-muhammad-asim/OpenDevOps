# Site settings read by update_dns.sh, verify_https.sh and browser_check.sh.
# Copy to sandbox/site.env (git-ignored) and fill in the server's public IP.
# After a server restart that changes the public IP, update HERMES_ORIGIN_IP
# here and the Cloudflare A record (see README "Server restarted / IP changed").
HERMES_HOST=hermes.saqlainmushtaq.com
HERMES_ORIGIN_IP=<server public IP>
