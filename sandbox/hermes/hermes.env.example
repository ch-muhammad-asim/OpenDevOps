# Copy to ~/.config/hermes-sandbox/hermes.env (chmod 600). Never commit the real file.
# Every variable explained, and how to rotate them: ../ENVIRONMENT.md (section 6).
# These values are consumed by Hermes itself, so they are passed with
# `--env-from` (kept out of process arguments), not as OpenShell providers.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
# Generate with Hermes's own helper:
#   printf '%s' 'YOUR-PASSWORD' | docker run --rm -i --entrypoint /opt/hermes/.venv/bin/python \
#     -w /opt/hermes nousresearch/hermes-agent:v0.23.0 -I -c \
#     "import sys; sys.path.insert(0,'/opt/hermes'); from plugins.dashboard_auth.basic import hash_password; print(hash_password(sys.stdin.read().strip()))"
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=scrypt$16384$8$1$REPLACE$REPLACE
# openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=REPLACE
# openssl rand -base64 32
API_SERVER_KEY=REPLACE
