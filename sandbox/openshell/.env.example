# Optional settings for sandbox/openshell/docker-compose.yml (the OpenShell
# gateway). Copy to .env in this folder only to change the default; no
# secrets belong here. Full reference: ../ENVIRONMENT.md
#
#   cp sandbox/openshell/.env.example sandbox/openshell/.env
#   docker compose -f sandbox/openshell/docker-compose.yml config   # check
#
# Gateway and init image tag (ghcr.io/nvidia/openshell/gateway). Keep it equal
# to the openshell CLI and to the sandbox/supervisor images pinned in
# gateway.toml; everything here is tested with 0.1.6 only.
OPENSHELL_VERSION=0.1.6
