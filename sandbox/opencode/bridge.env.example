# Settings for the OpenCode bridge container (docker-compose.example.yml in
# this folder, or the `bridge` service of your own Compose stack).
# Full reference: ../ENVIRONMENT.md
#
#   cp sandbox/opencode/bridge.env.example sandbox/opencode/bridge.env
#
# No secrets: the bridge needs no API key. OpenCode's free models run under
# an anonymous client identity that OpenCode creates on first use and keeps
# in the bridge-config volume (service.json); that volume is the only thing
# to protect.

# Listen address and port INSIDE the container. Publishing is done by the
# compose `ports:` line, which must stay 127.0.0.1:18383:18383 (no auth!).
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=18383

# Default model when a request names none. Hermes's provider (../hermes/
# config.yaml, `opencode-bridge`) asks for this one by default.
OPENCODE_BRIDGE_MODEL=opencode/mimo-v2.6-flash-free

# One request at a time (free tiers rate-limit). A second request waits up to
# OPENCODE_BRIDGE_QUEUE_WAIT seconds, then gets 429 "bridge busy".
OPENCODE_BRIDGE_MAX_CONCURRENCY=1
#OPENCODE_BRIDGE_QUEUE_WAIT=30

# Seconds per `opencode run` before the request fails.
OPENCODE_BRIDGE_TIMEOUT=180

# Kept for the record: bridge 1.0.0 does not read this variable (free-only is
# its built-in default, --free-only).
OPENCODE_BRIDGE_FREE_ONLY=1

# Optional: require `Authorization: Bearer <key>` from clients. Off here
# (empty): the bridge is reachable only from the server. If you set it,
# Hermes must send the same key: scripts/up.sh hard-codes
# `--env OPENCODE_BRIDGE_API_KEY=not-needed`, so change that line (or move
# the key into hermes.env and delete it) and re-create the sandbox.
#OPENCODE_BRIDGE_API_KEY=
