# Settings for the scripts in sandbox/scripts/ and sandbox/demo/scripts/ (the
# "operator" side: you, on the server or your laptop). Full reference, with
# every variable and its default: ENVIRONMENT.md
#
# NO SECRET VALUES IN THIS FILE: it holds settings and the PATHS of credential
# files. Secrets stay in their own chmod-600 files (or are typed in with
# `read -rs`, see the bottom of this file).
#
#   install -m 600 sandbox/operator.env.example ~/.config/hermes-sandbox/operator.env
#   set -a; . ~/.config/hermes-sandbox/operator.env; set +a
#   sandbox/scripts/verify.sh
#
# Every line is optional: the scripts use the defaults shown when unset.

# --- Site (also in sandbox/site.env, which update_dns.sh, verify_https.sh and
#     browser_check.sh read themselves; the other scripts default to the same
#     hostname) ---
#HERMES_HOST=hermes.saqlainmushtaq.com
#HERMES_ORIGIN_IP=3.82.194.180          # changes on every server restart
#HERMES_URL=https://hermes.saqlainmushtaq.com

# --- OpenShell and the sandbox ---------------------------------------------
#OPENSHELL=openshell                    # CLI binary (~/.local/bin/openshell)
#GATEWAY_NAME=hermes-gw                 # CLI name for the local gateway
#SANDBOX_NAME=hermes
#HERMES_IMAGE=nousresearch/hermes-agent:v0.22.5
#SANDBOX_IMAGE=hermes-openshell:v0.22.5
#DATA_VOLUME=hermes-data                # Docker volume with HERMES_HOME
#DASHBOARD_PORT=9119
#API_PORT=8642
#TMP_SIZE_BYTES=536870912               # sandbox /tmp size (512 MiB)
#HERMES_PROVIDERS=nvidia                # OpenShell providers to attach
#PROVIDER=nvidia                        # provider set_nvidia_key.sh writes
#HERMES_ADDR=172.31.250.10              # hermes-tunnel address the tests use

# --- Credential FILES (paths only; each file chmod 600) ----------------------
#HERMES_ENV_FILE=$HOME/.config/hermes-sandbox/hermes.env        # Hermes login + API key
#NVIDIA_API_KEY_FILE=$HOME/Desktop/sandbox/creds/nvidia/api      # nvidia_bench.py only
#CLOUDFLARE_API_TOKEN_FILE=$HOME/Desktop/sandbox/creds/cloudflare/dns/api   # update_dns.sh
#CLOUDFLARE_AI_CREDS_FILE=$HOME/Desktop/sandbox/creds/cloudflare/AI/api.txt # cf_ai_bench.py
#TRAEFIK_TLS_DIR=$HOME/.config/hermes-sandbox/tls               # origin.pem + origin.key

# --- Tests ------------------------------------------------------------------
#LLM_CHECKS=0          # 1 = tests also ask the model (uses free quota)
#BROWSER_CHECK=1       # verify_https.sh: 0 skips the real-browser section
#BROWSER_IDLE_SECONDS=180
#SWITCH_CHECK=0        # 1 = browser test switches the model and back (live!)
#CHROME=/usr/bin/google-chrome
#LLM_BUDGET=3          # demo: max model prompts per run

# --- Secrets: type them in, never store them here ---------------------------
#   read -rs HERMES_DASHBOARD_PASSWORD; export HERMES_DASHBOARD_PASSWORD
#   read -rs HERMES_API_KEY;            export HERMES_API_KEY
