# Optional settings for sandbox/tunnel/docker-compose.yml (hermes-tunnel).
# Copy to .env in this folder only to change a default; no secrets belong
# here. Full reference: ../ENVIRONMENT.md
#
#   cp sandbox/tunnel/.env.example sandbox/tunnel/.env
#   docker compose -f sandbox/tunnel/docker-compose.yml up -d --build
#
# OpenShell sandbox to forward into (same as SANDBOX_NAME for scripts/up.sh).
SANDBOX_NAME=hermes
# Hermes ports inside the sandbox. Traefik's routes (../traefik/dynamic/
# hermes.yml) expect these two; change all three places together.
DASHBOARD_PORT=9119
API_PORT=8642
# Seconds between health probes of each forward. After 3 failed probes in a
# row the forward is restarted (about 3 x this value).
HEALTH_INTERVAL=15
