# Optional settings for sandbox/traefik/docker-compose.yml.
# scripts/https_up.sh sets these for you; copy to .env only to run
# `docker compose` by hand. No secrets belong here. Reference: ../ENVIRONMENT.md
#
# No Let's Encrypt, no Cloudflare API token: Cloudflare's edge serves the
# browser-trusted certificate. Use Cloudflare SSL/TLS mode "Full", or
# "Full (strict)" once an origin certificate is installed (see below).

# User Traefik runs as (non-root). Use your own uid/gid (`id -u`, `id -g`)
# so Traefik can read an origin key that is chmod 600.
TRAEFIK_UID=1001
TRAEFIK_GID=1001

# Folder with an OPTIONAL Cloudflare Origin Certificate, mounted read-only:
#   origin.pem  certificate (chmod 644)
#   origin.key  private key (chmod 600, never in git)
# Create it in Cloudflare: SSL/TLS -> Origin Server -> Create Certificate.
# If the files are absent, Traefik uses its built-in self-signed certificate.
TRAEFIK_TLS_DIR=/home/<user>/.config/hermes-sandbox/tls
