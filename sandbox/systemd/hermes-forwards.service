# Runs sandbox/scripts/forwards.sh once; hermes-forwards.timer starts it at boot
# and every minute after. Install and test: sandbox/systemd/README.md.
[Unit]
Description=Hermes sandbox host-loopback forwards (dashboard 127.0.0.1:9119, API 127.0.0.1:8642)

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=FORWARDS_QUIET=1
Environment=FORWARDS_SCOPE=1
ExecStart=%h/OpenDevOps/sandbox/scripts/forwards.sh
TimeoutStartSec=600
# The forwards run in their own scopes (FORWARDS_SCOPE=1); never kill anything but the script.
KillMode=process
